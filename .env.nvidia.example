APP_ENVIRONMENT=development
REDIS_PASSWORD=
SECRET_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
CREDENTIAL_STORE_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_STORE_KEY

# NVIDIA API Catalog / hosted NIM endpoints
# Requiere cuenta del NVIDIA Developer Program y API key de build.nvidia.com

NVIDIA_USE_AS_L1=true
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=meta/llama-3.1-8b-instruct

# Opcional: mantener un L0 local y usar NVIDIA como apoyo cloud
# LLM_API_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model
