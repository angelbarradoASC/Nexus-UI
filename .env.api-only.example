APP_ENVIRONMENT=development
REDIS_PASSWORD=
SECRET_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
CREDENTIAL_STORE_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_STORE_KEY

# ==============================================================================
# API-only LLM setup for Nexus
# Sin modelos locales. Todo sale a APIs cloud.
# ==============================================================================

LLM_PRIORITY=cost

# ------------------------------------------------------------------------------
# Opcion 1: OpenRouter Free
# Documentacion:
# - https://openrouter.ai/pricing
# - https://openrouter.ai/docs/guides/routing/model-variants/free
# ------------------------------------------------------------------------------
LLM_L0_URL=
LLM_L0_KEY=
LLM_L0_MODEL=

LLM_L1_URL=https://openrouter.ai/api/v1
LLM_L1_KEY=REPLACE_WITH_OPENROUTER_KEY
LLM_L1_MODEL=baidu/cobuddy:free

# ------------------------------------------------------------------------------
# Opcion 2: Groq Free
# Descomenta estas lineas y comenta OpenRouter si prefieres Groq
# ------------------------------------------------------------------------------
#LLM_L1_URL=https://api.groq.com/openai/v1
#LLM_L1_KEY=REPLACE_WITH_GROQ_KEY
#LLM_L1_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# Opcion 3: Zhipu / GLM Flash gratuito
# Requiere adaptar base URL y modelo segun tu cuenta y endpoint real disponible
# ------------------------------------------------------------------------------
#LLM_L1_URL=https://open.bigmodel.cn/api/paas/v4
#LLM_L1_KEY=REPLACE_WITH_ZHIPU_KEY
#LLM_L1_MODEL=glm-4-flash

# Budget mensual (USD). 0 = sin limite.
LLM_MONTHLY_BUDGET_USD=0
LLM_BUDGET_ALERT_PCT=80
LLM_BUDGET_ACTION=downgrade
